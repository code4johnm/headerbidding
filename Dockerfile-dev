# Development image. The runtime user has no passwordless sudo.
# Requires a locally built image tagged openwpm from the Dockerfile.

FROM openwpm

USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /opt/firefox \
    && if [ -d /opt/OpenWPM/firefox-bin ]; then mv /opt/OpenWPM/firefox-bin /opt/firefox/firefox-bin; fi \
    && chown -R user:user /opt/OpenWPM /opt/firefox

COPY --chown=user:user test /opt/OpenWPM/test/
COPY --chown=user:user install-dev.sh requirements-dev.txt /opt/OpenWPM/

ENV FIREFOX_BINARY=/opt/firefox/firefox-bin/firefox-bin
USER user
WORKDIR /opt/OpenWPM
RUN ./install-dev.sh
